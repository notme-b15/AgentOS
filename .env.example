# ---- Supabase (hosted project: Project Settings -> API) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# BACKEND ONLY. Bypasses RLS. Never put this in the dashboard, MCP server or agent.
SUPABASE_SERVICE_ROLE_KEY=
# Used by the dashboard (Vite only exposes VITE_ variables)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---- Passport signing keys (generate with: npm run keys) ----
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# ---- Ports ----
API_PORT=4000
MOCK_STORE_PORT=4100

# ---- Used from Phase 4 onward ----
# GEMINI_API_KEY=

# ---- Phase 2: used only by `npm run try-it` (the approver you created in Supabase Auth) ----
TEST_EMAIL=
TEST_PASSWORD=
